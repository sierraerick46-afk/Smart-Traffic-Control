# Copy to .env (never commit .env). The application reads these variables from the environment.

# Required in production: random string used to sign the session cookies.
SECRET_KEY=change-me-to-a-long-random-string

# Database. Leave empty to use SQLite (data/app.db). For a persistent deployment use PostgreSQL:
# DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_URL=
# DATABASE_PATH=/var/data/app.db        # optional location of the SQLite file (for example a mounted disk)

# Send the session cookie only over HTTPS (set to 1 in production).
SESSION_COOKIE_SECURE=0

# First administrator (created at start-up if it does not exist).
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_EMAIL=

# Creates admin_test, operator_test and viewer_test with this password (for the instructor). Leave empty to skip.
TEST_USERS_PASSWORD=

ERICK_PASSWORD=
SANTIAGO_PASSWORD=
IVAN_PASSWORD=
EDWARD_PASSWORD=

# Optional folder for the .jsonl logs.
# LOG_DIR=logs
